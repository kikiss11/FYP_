# Google Trends Scraper Configuration
# Copy this file to .env and update values

# ===== Application =====
APP_NAME=google-trends-scraper
APP_ENV=development
DEBUG=true

# ===== Database =====
DATABASE_URL=postgresql://postgres:password@localhost:5432/google_trends
# For SQLite (simpler setup):
# DATABASE_URL=sqlite:///./data/trends.db

# ===== Redis (Optional - for caching) =====
REDIS_URL=redis://localhost:6379/0

# ===== Google Trends Settings =====
# Language for results
TRENDS_LANGUAGE=en-US
# Timezone offset (Hong Kong = 480)
TRENDS_TIMEZONE=480
# Request delay to avoid rate limiting (seconds)
REQUEST_DELAY=5

# ===== Scheduler =====
SCHEDULER_ENABLED=true
SCHEDULE_DAY_OF_WEEK=sunday
SCHEDULE_HOUR=2
SCHEDULE_MINUTE=0

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ===== Dashboard =====
DASHBOARD_PORT=8501

